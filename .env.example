# Copy to .env.local and fill in.
ADMIN_PASSWORD=choose-a-long-password
# Optional: a separate password for staff, which opens only the worker page (/worker)
WORKER_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=https://tczbrngigkysiiwgcexg.supabase.co
# Server-only. Supabase dashboard → Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=
# Your public website address, used for link previews (e.g. https://paperandmoments.my)
NEXT_PUBLIC_SITE_URL=
# NFC video tags: videos are stored in Cloudflare R2 (see README → NFC video tags)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public address, e.g. https://pub-xxxx.r2.dev or https://videos.example.com
R2_PUBLIC_URL=
# Testing on your own computer only (never in Vercel): keep tag videos in a temporary folder instead of R2
# TAG_STORAGE=local
